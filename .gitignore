# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Copias de conflicto estilo macOS (p. ej. de iCloud Drive, ya que el proyecto
# vive en Desktop) que a veces duplican carpetas de build con un sufijo " 2",
# " 3", etc. Nunca deben versionarse: son contenido de build, regenerable.
/.next */

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

# Registro de envíos del correo de lanzamiento (scripts/send-launch-emails.ts).
# Lleva direcciones reales de suscriptores: no debe salir del equipo donde se corre.
scripts/.launch-emails-sent.log

# Igual para el envío de reverificación de identidad (scripts/enviar-reverificacion.ts).
scripts/.reverificacion-sent.log

# Igual para el envío de reactivación (scripts/enviar-reactivacion.ts).
scripts/.reactivacion-sent.log
